DATABASE_URL=jdbc:postgresql://localhost:5433/ajoledger
DATABASE_USERNAME=ajoledger
DATABASE_PASSWORD=ajoledger

# Set to "dev" locally to enable dev-only endpoints (e.g. force-resolving a circle's round or
# enrollment without waiting for the scheduler). Never set this in prod.
SPRING_PROFILES_ACTIVE=dev

# Generate your own for local dev, e.g.: openssl rand -base64 32
JWT_SECRET=

# OAuth 2.0 client ID from Google Cloud Console; must match the frontend's VITE_GOOGLE_CLIENT_ID
GOOGLE_OAUTH_CLIENT_ID=

STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

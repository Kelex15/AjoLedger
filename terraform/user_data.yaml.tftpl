#cloud-config
write_files:
  - path: /opt/ajoledger/config.env
    permissions: '0600'
    content: |
      AWS_REGION=${aws_region}
      ECR_REPO_URL=${ecr_repo_url}
      DB_ADDRESS=${db_address}
      DOMAIN=${domain}
      CORS_ORIGIN=${cors_origin}
      JWT_SECRET_ARN=${jwt_secret_arn}
      STRIPE_API_KEY_ARN=${stripe_api_key_arn}
      STRIPE_WEBHOOK_SECRET_ARN=${stripe_webhook_secret_arn}
      PAYPAL_CLIENT_ID_ARN=${paypal_client_id_arn}
      PAYPAL_CLIENT_SECRET_ARN=${paypal_client_secret_arn}
      DB_SECRET_ARN=${db_secret_arn}
      DB_APP_SECRET_ARN=${db_app_secret_arn}
      RESEND_API_KEY_ARN=${resend_api_key_arn}
      GOOGLE_OAUTH_CLIENT_ID=${google_oauth_client_id}
      COOKIE_DOMAIN=${cookie_domain}
  - path: /opt/ajoledger/deploy.sh
    permissions: '0755'
    content: |
      ${indent(6, deploy_script)}

runcmd:
  - dnf install -y docker jq unzip postgresql16
  - systemctl enable --now docker
  - command -v aws || (curl -s "https://awscli.amazonaws.com/awscli-exe-linux-aarch64.zip" -o /tmp/awscliv2.zip && unzip -q /tmp/awscliv2.zip -d /tmp && /tmp/aws/install)
  - /opt/ajoledger/deploy.sh
